# Future vLLM example only. Do not use it during the direct Transformers stage.
# Copy to configs/l20.env later; the real file remains ignored.
MODEL_PATH=${HOME}/colacare_offline/models/Qwen3-4B-Instruct-2507
MODEL_DIR=${MODEL_PATH}
SERVED_MODEL_NAME=qwen3-4b-local
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=1
VLLM_GPU_MEMORY_UTILIZATION=0.85

LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=qwen3-4b-local
LLM_MAX_TOKENS=256
LLM_CONTEXT_LENGTH=4096
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=120

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
