# Local Ollama defaults. Copy to .env only if your shell/tool loads it;
# scripts read process environment variables and never read secrets from Git.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen3:4b
LLM_MAX_TOKENS=256
LLM_CONTEXT_LENGTH=4096
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=none

# Optional transport timeout in seconds.
LLM_TIMEOUT_SECONDS=60

# Future L20 vLLM switch: replace only these three LLM settings after the
# separately managed offline vLLM service has been verified.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL_NAME=qwen3-4b-local
